---
import { siteConfig } from '../config/site';
---

<section class="text-center flex flex-col items-center gap-2 sm:gap-3 py-0 my-0">
  <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full bg-[var(--bg-card)] border border-[var(--bg-card-border)] text-[11px] sm:text-xs font-semibold text-[var(--text-muted)]">
    <span class="w-2 h-2 rounded-full bg-[var(--accent-green)] shadow-[0_0_8px_var(--accent-green)] animate-pulse transform-gpu will-change-transform"></span>
    <span>{siteConfig.brand.pillText}</span>
  </div>

  <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight leading-[1.2]">
    连接你的 <span class="bg-gradient-to-r from-[var(--accent-cyan)] via-[#38bdf8] to-[var(--accent-pink)] bg-clip-text text-transparent">二次元世界</span>
  </h1>

  <p class="max-w-[560px] text-[var(--text-muted)] text-xs sm:text-sm md:text-base leading-relaxed px-1">
    {siteConfig.brand.description}
  </p>
</section>
