---
import { siteConfig } from '../config/site';
---

<section id="guide" class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <!-- Available Lines Box -->
  <div class="p-6 rounded-[1.25rem] bg-[var(--bg-surface)] border border-[var(--bg-card-border)] backdrop-blur-[20px] shadow-[var(--glass-shadow)]">
    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-[var(--accent-cyan)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <span>官方可用主线与备用域名</span>
    </h3>
    <div class="flex flex-col gap-2.5">
      {siteConfig.backupLines.map((line) => (
        <div class="flex justify-between items-center p-3 rounded-lg bg-[var(--bg-card)] border border-[var(--bg-card-border)] text-sm">
          <div>
            <div class="font-semibold text-[var(--text-main)]">{line.name}</div>
            <div class="text-xs text-[var(--accent-green)] flex items-center gap-1">● {line.status}</div>
          </div>
          <button
            data-url={line.url}
            class="copy-btn px-2.5 py-1 text-xs font-semibold text-[var(--accent-cyan)] hover:bg-[rgba(0,242,254,0.1)] rounded transition-colors"
          >
            复制链接
          </button>
        </div>
      ))}
    </div>
  </div>

  <!-- Anti-Lost Community Support Box -->
  <div class="p-6 rounded-[1.25rem] bg-[var(--bg-surface)] border border-[var(--bg-card-border)] backdrop-blur-[20px] shadow-[var(--glass-shadow)] flex flex-col justify-between">
    <div>
      <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-[var(--accent-pink)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        <span>防失联与社群支持</span>
      </h3>
      <p class="text-sm text-[var(--text-muted)] leading-relaxed mb-6">
        如遇网络环境限制或运营商 DNS 污染导致域名打不开，请优先加入官方 Telegram 交流频道获取最新防失联发布地址。
      </p>
    </div>

    <div class="flex gap-3 flex-wrap">
      <a
        href={siteConfig.socials.telegramUrl}
        target="_blank"
        rel="noopener"
        class="flex-1 min-w-[140px] flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold bg-[var(--bg-card)] border border-[var(--bg-card-border)] hover:bg-[var(--bg-surface-hover)] hover:border-[var(--bg-card-border-hover)] text-[var(--text-main)] transition-all"
      >
        <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        <span>官方 TG 交流群</span>
      </a>
      <a
        href={siteConfig.socials.githubUrl}
        target="_blank"
        rel="noopener"
        class="flex-1 min-w-[140px] flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold bg-[var(--bg-card)] border border-[var(--bg-card-border)] hover:bg-[var(--bg-surface-hover)] hover:border-[var(--bg-card-border-hover)] text-[var(--text-main)] transition-all"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        <span>GitHub 仓库</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      if (url && navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          const original = btn.textContent;
          btn.textContent = '已复制！';
          setTimeout(() => { btn.textContent = original; }, 1800);
        });
      }
    });
  });
</script>
