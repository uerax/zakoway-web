---
import { siteConfig } from '../config/site';
---

<header class="flex justify-between items-center gap-2 sm:gap-4 px-3.5 sm:px-5 py-2.5 sm:py-3 rounded-2xl sm:rounded-full bg-[var(--bg-surface)] backdrop-blur-md sm:backdrop-blur-[20px] border border-[var(--bg-card-border)] shadow-[var(--glass-shadow)]">
  <a href="/" class="flex items-center gap-2 sm:gap-3 no-underline text-inherit group shrink-0">
    <img
      src="/logo.png"
      alt={siteConfig.brand.name}
      class="w-7 h-7 sm:w-9 sm:h-9 rounded-lg sm:rounded-xl object-contain drop-shadow-[0_2px_8px_rgba(0,242,254,0.35)] transition-transform duration-300 group-hover:scale-105"
    />
    <div class="font-bold text-base sm:text-lg tracking-tight bg-gradient-to-r from-[var(--text-main)] to-[var(--text-muted)] bg-clip-text text-transparent">
      {siteConfig.brand.name}
    </div>
  </a>

  <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
    <a href="#matrix" class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 text-xs sm:text-sm font-medium rounded-xl sm:rounded-full bg-[var(--bg-card)] border border-[var(--bg-card-border)] text-[var(--text-main)] hover:bg-[var(--bg-surface-hover)] hover:border-[var(--bg-card-border-hover)] transition-all touch-manipulation" title="查看产品矩阵">
      <svg class="w-4 h-4 text-[var(--accent-cyan)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
      <span class="hidden sm:inline">产品矩阵</span>
    </a>
    <a href="#guide" class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 text-xs sm:text-sm font-medium rounded-xl sm:rounded-full bg-[var(--bg-card)] border border-[var(--bg-card-border)] text-[var(--text-main)] hover:bg-[var(--bg-surface-hover)] hover:border-[var(--bg-card-border-hover)] transition-all touch-manipulation" title="防失联与备用域名">
      <svg class="w-4 h-4 text-[var(--accent-pink)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
      <span class="hidden sm:inline">防失联</span>
    </a>
    <button onclick="window.toggleTheme()" class="p-1.5 sm:p-2 rounded-xl sm:rounded-full bg-[var(--bg-card)] border border-[var(--bg-card-border)] text-[var(--text-main)] hover:bg-[var(--bg-surface-hover)] transition-all touch-manipulation" title="切换模式" aria-label="切换明暗主题">
      <svg class="w-4 h-4 shrink-0 dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      <svg class="w-4 h-4 shrink-0 light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
    </button>
  </div>
</header>
